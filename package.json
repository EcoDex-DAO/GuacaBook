{
  "name": "guacabook",
  "version": "1.0.0-beta.7",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node tests/browser.mjs",
    "version:patch": "node --import tsx scripts/version.ts patch",
    "version:minor": "node --import tsx scripts/version.ts minor",
    "version:major": "node --import tsx scripts/version.ts major",
    "version:prerelease": "node --import tsx scripts/version.ts prerelease",
    "version:stable": "node --import tsx scripts/version.ts stable",
    "version:auto": "node --import tsx scripts/version.ts auto"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "exifr": "^7.1.3",
    "jszip": "^3.10.1",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
